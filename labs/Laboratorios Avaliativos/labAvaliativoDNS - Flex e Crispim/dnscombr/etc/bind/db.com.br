; BIND reverse data file for empty rfc1918 zone
;
; DO NOT EDIT THIS FILE - it is used for multiple zones.
; Instead, copy it, edit named.conf, and use that copy.
;
$TTL    86400
@       IN      SOA     dnscombr.com.br. root.dnscombr.com.br. (
                              1         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                          86400 )       ; Negative Cache TTL
;
@       IN      NS      dnscombr.com.br.
dnscombr	A       150.1.2.3
commerce.com.br.	A       200.0.0.100
interno.com.br.		A	50.0.0.1
interno.com.br.		A	192.168.1.1
